#!/bin/bash
# A stand-in for the codex CLI, so the adapter's lifecycle can be tested without
# spending a real Codex run -- and so failure shapes that a real run will not
# produce on demand (a grandchild holding stdout, a child that never reads stdin)
# can be produced deliberately.
#
# FAKE_MODE picks the shape. FAKE_EVIDENCE is where the "worker" writes.
[ "$1" = "--version" ] && { echo "fake-codex 0.0.1"; exit 0; }
EV="$FAKE_EVIDENCE"
case "$FAKE_MODE" in
  ok)
    printf '{"type":"turn.completed"}\n'
    printf 'work\n\nStatus: DONE\nSummary: ok\nConcerns/Blockers: none\n' > "$EV"
    exit 0 ;;
  grandchild)   # exits at once, but a grandchild keeps stdout open
    printf '{"type":"turn.completed"}\n'
    printf 'work\n\nStatus: DONE\nSummary: ok\n' > "$EV"
    ( sleep 30; echo late ) &
    exit 0 ;;
  nodrain)      # exits without reading stdin -> EPIPE on a brief over the pipe buffer
    exit 7 ;;
  stderr_only)  # never emits a stdout event: the watchdog must still fire
    while :; do printf 'still working...\n' >&2; sleep 1; done ;;
  blocked)
    printf '{"type":"turn.completed"}\n'
    printf 'stopped\n\nStatus: BLOCKED\nConcerns/Blockers: COST_GATE — Ahrefs\n' > "$EV"
    exit 0 ;;
  envdump)      # reports which env vars reached the worker, never their values
    printf '{"type":"turn.completed"}\n'
    {
      printf 'TOKEN=%s\n' "${GOOGLE_WORKSPACE_CLI_TOKEN:+present}${GOOGLE_WORKSPACE_CLI_TOKEN:-absent}"
      printf 'KEYRING=%s\n' "${GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND:+present}${GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND:-absent}"
      printf 'ROLE=%s\n' "${MWG_CREW_ROLE:-unset}"
      printf '\nStatus: DONE\nSummary: env dumped\n'
    } > "$EV"
    exit 0 ;;
  tamper)       # a worker that deletes a file out of the credential store
    printf '{"type":"turn.completed"}\n'
    rm -f "$GOOGLE_WORKSPACE_CLI_CONFIG_DIR/credentials.enc"
    printf 'removed the store file\n\nStatus: DONE\nSummary: ok\n' > "$EV"
    exit 0 ;;
  holds_tamper) # a worker that rewrites the run's hold queue mid-job
    printf '{"type":"turn.completed"}\n'
    node -e 'const f=process.argv[1],fs=require("fs"),m=JSON.parse(fs.readFileSync(f,"utf8"));m.holds=[{id:"h1",seq:1,attempt:"x",kind:"cost_gate",api:"Ahrefs",question:"q",options:[],status:"answered",createdAt:"x",createdBy:"collect",answer:{words:"worker tu tra loi",outcome:"drop",via:"chat",at:"x"}}];fs.writeFileSync(f,JSON.stringify(m))' "$FAKE_MANIFEST"
    printf 'ok\n\nStatus: DONE\nSummary: ok\n' > "$EV"
    exit 0 ;;
  argvdump)     # reports the argv the adapter actually built, so a flag can be
                # asserted where it lands rather than where it was typed
    printf '{"type":"turn.completed"}\n'
    {
      printf 'ARGV=%s\n' "$*"
      printf '\nStatus: DONE\nSummary: argv dumped\n'
    } > "$EV"
    exit 0 ;;
  thread)
    # Honours -o: the adapter promises the worker's final message lands there,
    # and nothing asserted that until the path was written for real.
    for i in $(seq 1 $#); do
      if [ "${!i}" = "-o" ]; then j=$((i+1)); printf 'reply\n' > "${!j}"; fi
    done
    # Emits the thread.started event every real run opens with, so the adapter's
    # capture of the session id can be asserted. FAKE_THREAD_ID overrides it.
    printf '{"type":"thread.started","thread_id":"%s"}\n' "${FAKE_THREAD_ID:-01a04169-2763-79d1-9037-6dc85981fad1}"
    printf '{"type":"turn.completed"}\n'
    {
      printf 'ARGV=%s\n' "$*"
      printf '\nStatus: DONE\nSummary: ok\n'
    } > "$EV"
    exit 0 ;;
  briefdump)    # writes back the brief it was actually handed on stdin, so the
                # contract lines can be asserted where the worker reads them
    printf '{"type":"turn.completed"}\n'
    {
      cat
      printf '\nStatus: DONE\nSummary: brief dumped\n'
    } > "$EV"
    exit 0 ;;
  no_status)    # finished, but ignored the contract's Status line
    printf '{"type":"turn.completed"}\n'
    printf 'did some work and forgot the contract\n' > "$EV"
    exit 0 ;;
  hang_handoff|hang_rescue_hang|hang_rescue_nostatus|hang_silent)
    # A job that runs past its timeout. The first call works forever (emitting
    # events so the idle watchdog stays quiet); the handoff rescue arrives as
    # `exec ... resume <id>`, and what it does depends on the mode.
    # FAKE_RESCUE_MARK records each rescue call, so "no rescue" is observable.
    if [[ " $* " == *" resume "* ]]; then
      [ -n "$FAKE_RESCUE_MARK" ] && echo "rescue $*" >> "$FAKE_RESCUE_MARK"
      cat > /dev/null
      case "$FAKE_MODE" in
        hang_handoff)
          printf '{"type":"turn.completed"}\n'
          printf '\n## Handoff\n### Đã xong\n- bước 1\n### Đang dở\n- bước 2\n### Bước kế tiếp\n- làm nốt bước 2\n### File đã đụng\nKhông có\n\nStatus: CONTINUE\n' >> "$EV"
          exit 0 ;;
        hang_rescue_hang) exec sleep 60 ;;
        hang_rescue_nostatus) printf '{"type":"turn.completed"}\n'; exit 0 ;;
      esac
    fi
    cat > /dev/null
    printf '{"type":"thread.started","thread_id":"%s"}\n' "${FAKE_THREAD_ID:-01a04169-2763-79d1-9037-6dc85981fad1}"
    printf 'phần đầu của việc\n' > "$EV"
    if [ "$FAKE_MODE" = "hang_silent" ]; then exec sleep 60; fi
    while :; do printf '{"type":"item.updated"}\n'; sleep 1; done ;;
  *) echo "fake-codex: unknown FAKE_MODE '$FAKE_MODE'" >&2; exit 99 ;;
esac
